{
  "include": [
    "docs/**/*.md",
    "skills/**/*.md",
    "README.md",
    "CONTRIBUTING.md",
    "AGENTS.md"
  ],
  "indexes": ["README.md"],
  "tokenBudgets": {
    "perDoc": 2600,
    "bankSlack": 0.25,
    "overrides": [],
    "contextSets": []
  },
  "structure": {
    "maxHeadingDepth": 4,
    "summaryWithinTokens": 250,
    "requiredFields": [
      {
        "glob": "docs/decisions/ENG-*.md",
        "fields": [
          {
            "name": "Status",
            "pattern": "^(Proposed|Accepted|Superseded by ENG-\\d{4})$"
          },
          {
            "name": "Date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        ]
      },
      {
        "glob": "docs/decisions/ENG-*.md",
        "exclude": [
          "docs/decisions/ENG-000?-*.md",
          "docs/decisions/ENG-0010-*.md"
        ],
        "fields": [
          {
            "name": "Issue",
            "pattern": "^qwts/[\\w.-]+#\\d+$"
          }
        ]
      },
      {
        "glob": "docs/decisions/ENG-000?-*.md",
        "fields": [
          {
            "name": "Issue",
            "pattern": "^(qwts/[\\w.-]+#\\d+|predates issue-first \\(ENG-0013\\))$"
          }
        ]
      },
      {
        "glob": "docs/decisions/ENG-0010-*.md",
        "fields": [
          {
            "name": "Issue",
            "pattern": "^(qwts/[\\w.-]+#\\d+|predates issue-first \\(ENG-0013\\))$"
          }
        ]
      }
    ]
  },
  "antiPatterns": {
    "positionalReferences": true,
    "unresolvedPlaceholders": true,
    "duplicateParagraphs": {
      "minLength": 160,
      "allow": []
    },
    "terminology": []
  },
  "integrity": {
    "links": true,
    "orphans": true,
    "stalePaths": {
      "roots": ["docs"]
    }
  },
  "decisionSeries": {
    "glob": "docs/decisions/ENG-*.md",
    "issueField": "Issue",
    "homeRepo": "qwts/agent-sop",
    "homeRepoAliases": ["qwts/playbook-engineering", "qwts/dev-steward"],
    "grandfathered": [
      "docs/decisions/ENG-000?-*.md",
      "docs/decisions/ENG-001?-*.md"
    ]
  }
}
